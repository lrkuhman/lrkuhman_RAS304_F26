<mxfile host="app.diagrams.net"><diagram name="LiDAR Block Diagram" id="lidarbd"><mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="820" height="660" as="geometry"/></mxCell><mxCell id="c3" value="LiDAR Subsystem&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#808080&quot;&gt;Landon K.&lt;/font&gt;&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="612" width="160" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Power source&lt;/b&gt;&lt;br&gt;3S Li-ion pack: 3 × 18650 in series&lt;br&gt;9.0–12.6 V, 3000 mAh&lt;br&gt;&lt;font color=&quot;#808080&quot;&gt;(9 V adapter on the bench)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="220" height="74" as="geometry"/></mxCell><mxCell id="c5" value="J1 barrel jack" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="220" height="36" as="geometry"/></mxCell><mxCell id="c6" value="F1 800 mA slow-blow fuse" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="222" width="220" height="36" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;U2 LM2940CT-5.0&lt;/b&gt;&lt;br&gt;+5 V low-dropout regulator (with heatsink)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="294" width="220" height="52" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Connector 1&lt;/b&gt; (team ribbon to MASTER)&lt;br&gt;Pin 1: UART in · Pin 2: UART out · Pin 8: GND" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vert